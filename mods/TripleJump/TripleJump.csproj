<Project Sdk="Microsoft.NET.Sdk">
  <!-- Most settings (framework, references, deploy, packaging) come from ../../Directory.Build.props/.targets -->
  <PropertyGroup>
    <AssemblyName>TripleJump</AssemblyName>
    <RootNamespace>TripleJump</RootNamespace>
    <Version>1.0.1</Version>
    <Description>Jump up to two extra times in mid-air.</Description>

    <!-- Used by BepInEx.PluginInfoProps to generate MyPluginInfo -->
    <BepInExPluginGuid>com.boplmods.triplejump</BepInExPluginGuid>
    <BepInExPluginName>Triple Jump</BepInExPluginName>
  </PropertyGroup>
</Project>
